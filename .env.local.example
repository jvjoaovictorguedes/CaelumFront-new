NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Login com Google — Client ID OAuth 2.0 (tipo "Web application") do
# Google Cloud Console. Público de propósito (vai no botão do
# navegador) — o client_secret NUNCA entra aqui, o backend não usa um
# (fluxo de ID token, ver src/services/googleAuthService.js no back).
# Sem essa variável, o botão "Entrar com Google" simplesmente não aparece.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=